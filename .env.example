# ---------------------------------------------------------------------------
# MyRadius backend — environment template
#
# Copy to .env and adjust: `cp .env.example .env` is enough for a working local
# stack, because the defaults below match docker-compose.yml.
#
# Never commit a real .env.
# ---------------------------------------------------------------------------

# -- Application ------------------------------------------------------------
APP_NAME=MyRadius
# local | test | staging | production
APP_ENV=local
DEBUG=true
API_PREFIX=/v1

# Signing key for tokens (used from Phase 1). Generate one per environment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required in staging and production: the app refuses to boot with this default.
SECRET_KEY=dev-secret-not-for-production

# -- Database ---------------------------------------------------------------
# Host is the compose service name from inside containers, localhost from the host.
DATABASE_URL=postgresql+asyncpg://myradius:myradius@postgres:5432/myradius
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false
# Server-side statement timeout in milliseconds; 0 disables it.
DB_STATEMENT_TIMEOUT_MS=10000

# Credentials the postgres container initialises itself with. Keep in step with
# DATABASE_URL above.
POSTGRES_USER=myradius
POSTGRES_PASSWORD=myradius
POSTGRES_DB=myradius

# -- Redis ------------------------------------------------------------------
# Cache, rate limits, OTPs, pub/sub, and the arq queue.
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=50

# -- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
# json in deployed environments; console is easier to read locally.
LOG_FORMAT=console
LOG_ACCESS=true
LOG_ACCESS_EXCLUDE=/health,/ready,/metrics

# -- HTTP -------------------------------------------------------------------
# Comma-separated origins. Leave empty for the native apps; set it only if a
# browser client such as the admin console needs access.
CORS_ORIGINS=
# Enable ONLY behind a reverse proxy that overwrites X-Forwarded-For. Otherwise
# clients can forge their own IP and bypass per-IP rate limits.
TRUST_FORWARDED_FOR=false

# -- Rate limiting ----------------------------------------------------------
RATE_LIMIT_ENABLED=true
# true: allow requests when Redis is unreachable. false: reject them.
RATE_LIMIT_FAIL_OPEN=true

# -- Pagination -------------------------------------------------------------
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100

# ---------------------------------------------------------------------------
# Tests
#
# Used by the test suite only. CI sets these to its service containers; the
# values below point at the local compose stack as seen from the host.
# ---------------------------------------------------------------------------
TEST_DATABASE_URL=postgresql+asyncpg://myradius:myradius@localhost:5432/myradius_test
TEST_REDIS_URL=redis://localhost:6379/15
