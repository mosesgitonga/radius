# ---------------------------------------------------------------------------
# MyRadius backend — environment template
#
# Copy to .env and adjust: `cp .env.example .env` is enough for a working local
# stack, because the defaults below match docker-compose.yml.
#
# Never commit a real .env.
# ---------------------------------------------------------------------------

# -- Application ------------------------------------------------------------
APP_NAME=MyRadius
# local | test | staging | production
APP_ENV=local
DEBUG=true
API_PREFIX=/v1

# Signing key for tokens (used from Phase 1). Generate one per environment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required in staging and production: the app refuses to boot with this default,
# or with any key shorter than 32 bytes (RFC 7518 for HMAC-SHA256).
SECRET_KEY=dev-secret-not-for-production

# -- Database ---------------------------------------------------------------
# Host is the compose service name from inside containers, localhost from the host.
DATABASE_URL=postgresql+asyncpg://myradius:myradius@postgres:5432/myradius
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false
# Server-side statement timeout in milliseconds; 0 disables it.
DB_STATEMENT_TIMEOUT_MS=10000

# Credentials the postgres container initialises itself with. Keep in step with
# DATABASE_URL above.
POSTGRES_USER=myradius
POSTGRES_PASSWORD=myradius
POSTGRES_DB=myradius

# -- Redis ------------------------------------------------------------------
# Cache, rate limits, OTPs, pub/sub, and the arq queue.
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=50

# -- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
# json in deployed environments; console is easier to read locally.
LOG_FORMAT=console
LOG_ACCESS=true
LOG_ACCESS_EXCLUDE=/health,/ready,/metrics

# -- HTTP -------------------------------------------------------------------
# Comma-separated origins. Leave empty for the native apps; set it only if a
# browser client such as the admin console needs access.
CORS_ORIGINS=
# Enable ONLY behind a reverse proxy that overwrites X-Forwarded-For. Otherwise
# clients can forge their own IP and bypass per-IP rate limits.
TRUST_FORWARDED_FOR=false

# -- Rate limiting ----------------------------------------------------------
RATE_LIMIT_ENABLED=true
# true: allow requests when Redis is unreachable. false: reject them.
RATE_LIMIT_FAIL_OPEN=true

# -- Pagination -------------------------------------------------------------
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100

# -- Object storage ---------------------------------------------------------
# s3 | memory. The compose stack runs SeaweedFS, an S3-compatible server, so
# the presigned-upload flow works locally. `memory` keeps images in process and
# loses them on restart; the test suite always uses it.
STORAGE_PROVIDER=s3
STORAGE_BUCKET=myradius-media
STORAGE_REGION=auto
# Where the server reaches storage. Inside compose that is the service name.
STORAGE_ENDPOINT_URL=http://storage:8333
# Where *clients* upload to. Different from the above only because a phone
# cannot resolve `storage`; the host is part of the signature, so it must be set.
# Leave empty for R2 or S3, where both are the same public endpoint.
STORAGE_PRESIGN_ENDPOINT_URL=http://localhost:8333
STORAGE_ACCESS_KEY_ID=myradius-dev
STORAGE_SECRET_ACCESS_KEY=myradius-dev-secret-not-for-production
# A CDN or public bucket URL for processed images. Strongly preferred in
# production: presigned GETs are unique per request and defeat caching, which
# costs users data on every screen.
STORAGE_PUBLIC_BASE_URL=
STORAGE_FORCE_PATH_STYLE=true

# -- Media ------------------------------------------------------------------
MEDIA_MAX_UPLOAD_BYTES=12582912
MEDIA_MAX_PIXELS=50000000
MEDIA_WEBP_SIZES=320,720,1280
MEDIA_WEBP_QUALITY=80

# -- Content ----------------------------------------------------------------
POST_MAX_BODY_LENGTH=2000
POST_MAX_IMAGES=6
POST_CATEGORIES=general,question,recommendation,lost_and_found,alert
STORY_TTL_HOURS=24
COMMENT_MAX_LENGTH=1000
REACTION_KINDS=like,love,helpful,celebrate,sad

# -- Moderation -------------------------------------------------------------
# Distinct established reporters needed to hide content pending review.
REPORT_AUTO_HIDE_THRESHOLD=3
TRUSTED_REPORTER_MIN_ACCOUNT_AGE_DAYS=7

# -- New-account limits -----------------------------------------------------
# Accounts younger than this get the tighter limits.
NEW_ACCOUNT_AGE_HOURS=48
NEW_ACCOUNT_POSTS_PER_DAY=5
NEW_ACCOUNT_COMMENTS_PER_HOUR=10
NEW_ACCOUNT_STORIES_PER_DAY=3
POSTS_PER_DAY=30
COMMENTS_PER_HOUR=60
STORIES_PER_DAY=10

# -- Idempotency ------------------------------------------------------------
IDEMPOTENCY_TTL_HOURS=24

# -- Messaging --------------------------------------------------------------
MESSAGE_MAX_LENGTH=4000
GROUP_CHAT_MEMBER_LIMIT=256
GROUP_CHAT_TITLE_MAX_LENGTH=80
MESSAGES_PER_MINUTE=30
NEW_ACCOUNT_MESSAGES_PER_MINUTE=10
MESSAGE_REQUESTS_PER_DAY=20
NEW_ACCOUNT_MESSAGE_REQUESTS_PER_DAY=5

# -- Realtime ---------------------------------------------------------------
WS_AUTH_TIMEOUT_SECONDS=10
WS_HEARTBEAT_SECONDS=25
PRESENCE_TTL_SECONDS=60
SYNC_OVERLAP_SECONDS=30

# -- Notifications ----------------------------------------------------------
# `fake` records pushes instead of sending them; production refuses it. For FCM,
# mount a Firebase service-account JSON file and point at it. Never commit it.
PUSH_PROVIDER=fake
FCM_CREDENTIALS_FILE=
PUSH_THROTTLE_SECONDS=60
NOTIFICATION_COLLAPSE_WINDOW_MINUTES=60
NOTIFICATION_RETENTION_DAYS=90
DEVICE_TOKEN_STALE_DAYS=90

# ---------------------------------------------------------------------------
# Tests
#
# Used by the test suite only. CI sets these to its service containers; the
# values below point at the local compose stack as seen from the host.
# ---------------------------------------------------------------------------
TEST_DATABASE_URL=postgresql+asyncpg://myradius:myradius@localhost:5432/myradius_test
TEST_REDIS_URL=redis://localhost:6379/15
